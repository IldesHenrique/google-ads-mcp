      "description": "Retrieves the selectable, filterable, and sortable fields for a specific Google Ads resource,\nincluding compatible metrics and segments.\n\nUse this tool to find out which fields you can select, filter by, or sort by\nwhen querying a specific resource (e.g., 'campaign', 'ad_group').\nThis tool also returns metrics and segments that can be selected with the resource.\nTheir names start with 'metrics.' and 'segments.' respectively.\n\nDo not guess fields, you MUST use this tool to discover them before constructing a query for the\n`search` tool.\n\nThe responses of this tool should be cached, as they don't change frequently.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "login_customer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional manager customer ID to use as the login-customer-id header."
          },
          "resource_name": {
            "description": "The name of the Google Ads resource (e.g., 'campaign', 'ad_group').",
            "type": "string"
          }
        },
        "required": [
          "resource_name"
        ],
        "type": "object"
      },
      "name": "metadata_get_resource_metadata",
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Metadata Get Resource Metadata"
